# Copie este archivo a .env y reemplace las claves. .env está excluido de git.
# Los valores de abajo son EJEMPLOS, no credenciales reales.

# --- Base de datos del producto (servicio "db") ---
POSTGRES_DB=novamercado
POSTGRES_USER=novamercado
POSTGRES_PASSWORD=cambie_esta_clave
# Puerto publicado solo en 127.0.0.1 para usar la base desde el equipo
PRODUCTO_DB_PUERTO_HOST=5433

# URL que usan la API, Alembic y los scripts fuera de Docker (debe coincidir con lo anterior)
DATABASE_URL=postgresql+psycopg2://novamercado:cambie_esta_clave@localhost:5433/novamercado
# Segundos de espera al conectar antes de informar que la base no está disponible
DB_TIMEOUT_CONEXION=5
# Límite por consulta: PostgreSQL la cancela a los DB_TIMEOUT_CONSULTA s (statement_timeout);
# si el servidor no responde, el cliente corta la conexión a los DB_TIMEOUT_CONSULTA + DB_MARGEN_CLIENTE s
DB_TIMEOUT_CONSULTA=5
DB_MARGEN_CLIENTE=2

# --- Base de datos de Airflow (servicio "airflow-db", separada del producto) ---
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=cambie_esta_otra_clave

# --- MLflow (etapa 5) ---
# Origen del modelo: mlflow (producto) o archivo (desarrollo y pruebas, etapa 4)
MODELO_ORIGEN=mlflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_PUERTO_HOST=5000
MLFLOW_MODELO_NOMBRE=novamercado-ventas
MLFLOW_ALIAS=vigente
# Límites del cliente de MLflow (sus valores por defecto, 120 s y 7 reintentos, pueden bloquear minutos)
MLFLOW_HTTP_REQUEST_TIMEOUT=5
MLFLOW_HTTP_REQUEST_MAX_RETRIES=0
# Caché local de modelos validados (para predecir con MLflow caído); no se versiona
MODELO_CACHE_DIR=modelos/cache
# Hilos de OpenMP fijos al entrenar: con 1 el entrenamiento es determinista byte a byte
HILOS_ENTRENAMIENTO=1

# --- API ---
# Solo con MODELO_ORIGEN=archivo: artefacto de python -m app.modelo.entrenar_local
MODELO_RUTA=modelos/modelo_local.joblib
# Segundos entre comprobaciones del alias o del artefacto (la API carga el modelo nuevo sin reiniciar)
MODELO_INTERVALO_REFRESCO=15
# Componentes que deben estar disponibles para que /health responda "ok": COMPONENTES_REQUERIDOS.
# No se define aquí a propósito: sin definir se deriva de MODELO_ORIGEN (base_datos,modelo y,
# con MODELO_ORIGEN=mlflow, también mlflow). Definirla anula esa selección. Airflow llega en la etapa 7.
# Monitor de salud: intervalo entre ciclos y límite global por ciclo (segundos)
SALUD_INTERVALO=10
SALUD_LIMITE=3
