# Copie este archivo a .env y reemplace las claves. .env está excluido de git.
# Los valores de abajo son EJEMPLOS, no credenciales reales.

# --- Base de datos del producto (servicio "db") ---
POSTGRES_DB=novamercado
POSTGRES_USER=novamercado
POSTGRES_PASSWORD=cambie_esta_clave
# Puerto publicado solo en 127.0.0.1 para usar la base desde el equipo
PRODUCTO_DB_PUERTO_HOST=5433

# URL que usan la API, Alembic y los scripts fuera de Docker (debe coincidir con lo anterior)
DATABASE_URL=postgresql+psycopg2://novamercado:cambie_esta_clave@localhost:5433/novamercado
# Segundos de espera al conectar antes de informar que la base no está disponible
DB_TIMEOUT_CONEXION=5

# --- Base de datos de Airflow (servicio "airflow-db", separada del producto) ---
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=cambie_esta_otra_clave

# --- API (etapa 4) ---
# Artefacto del modelo local (python -m app.modelo.entrenar_local); modelos/ no se versiona
MODELO_RUTA=modelos/modelo_local.joblib
# Segundos entre comprobaciones de un modelo nuevo (la API lo carga sin reiniciar)
MODELO_INTERVALO_REFRESCO=30
# Componentes que deben estar disponibles para que /health responda "ok".
# Etapa 4: MLflow y Airflow todavía no existen; desde la etapa 6 se exigirán los cinco.
COMPONENTES_REQUERIDOS=base_datos,modelo
# Monitor de salud: intervalo entre ciclos y límite global por ciclo (segundos)
SALUD_INTERVALO=10
SALUD_LIMITE=3
